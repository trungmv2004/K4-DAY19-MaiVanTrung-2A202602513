# Copy to .env (never commit .env). This implementation selects OpenRouter for both
# chat and embeddings, so fill OPENROUTER_API_KEY. To use another provider, change
# LLM_PROVIDER / EMBEDDING_PROVIDER below. Without those settings, auto-detection
# is OpenAI -> OpenRouter -> Gemini -> Anthropic (Anthropic is chat-only).
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Explicit provider selection (overrides auto-detection)
LLM_PROVIDER=openrouter       # openai | openrouter | gemini | anthropic
EMBEDDING_PROVIDER=openrouter # openai | openrouter | gemini

# Optional: override default models (<PROVIDER>_CHAT_MODEL / <PROVIDER>_EMBEDDING_MODEL)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# ANTHROPIC_CHAT_MODEL=claude-opus-5-5

# Must match NEO4J_AUTH used in `docker run`
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
